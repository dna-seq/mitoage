---
/**
 * Decorative brand texture: faceted low-poly triangles plus a constellation of dots and
 * lines, generated deterministically from `seed`. Fills its positioned parent.
 *
 * <HeroBackdrop seed={7} height={600} constellation="right" />
 */
import { seededRandom } from "~/lib/random";

interface Props {
  /** Any integer; the same seed always gives the same pattern. */
  seed?: number;
  /** viewBox height (width is 1400). Match the hero's aspect so facets are not squashed. */
  height?: number;
  /** Where the constellation sits. */
  constellation?: "right" | "left" | "full" | "none";
  /** Approximate number of facet columns. */
  columns?: number;
  /** Number of constellation stars. */
  stars?: number;
  /** Twinkle a few stars (disabled under prefers-reduced-motion). */
  animate?: boolean;
  class?: string;
}

const {
  seed = 1,
  height = 600,
  constellation = "right",
  columns = 7,
  stars = 24,
  animate = true,
  class: className,
} = Astro.props;

const W = 1400;
const H = height;
const rand = seededRandom(seed * 7919 + 13);
const r1 = (n: number) => Math.round(n * 10) / 10;

// ---- Facets: jittered grid, each cell split along a random diagonal ----
const cols = Math.max(3, columns);
const cw = W / cols;
const rows = Math.max(2, Math.round(H / cw) + 1);
const rh = H / rows;
const grid: [number, number][][] = [];
for (let j = 0; j <= rows; j++) {
  const row: [number, number][] = [];
  for (let i = 0; i <= cols; i++) {
    const edgeX = i === 0 || i === cols;
    const edgeY = j === 0 || j === rows;
    const jx = edgeX ? 0 : (rand() - 0.5) * cw * 0.7;
    const jy = edgeY ? 0 : (rand() - 0.5) * rh * 0.7;
    row.push([r1(i * cw + jx), r1(j * rh + jy)]);
  }
  grid.push(row);
}
interface Facet {
  points: string;
  fill: "light" | "dark";
  opacity: number;
}
const facets: Facet[] = [];
const pushTri = (a: [number, number], b: [number, number], c: [number, number]) => {
  const fx = (a[0] + b[0] + c[0]) / 3 / W;
  const dark = rand() < 0.2;
  const opacity = dark ? 0.05 + rand() * 0.07 : 0.02 + fx * 0.11 + rand() * 0.05;
  facets.push({ points: `${a.join(",")} ${b.join(",")} ${c.join(",")}`, fill: dark ? "dark" : "light", opacity: r1(opacity * 1000) / 1000 });
};
for (let j = 0; j < rows; j++) {
  for (let i = 0; i < cols; i++) {
    const p00 = grid[j]?.[i];
    const p10 = grid[j]?.[i + 1];
    const p01 = grid[j + 1]?.[i];
    const p11 = grid[j + 1]?.[i + 1];
    if (!p00 || !p10 || !p01 || !p11) continue;
    if (rand() < 0.5) {
      pushTri(p00, p10, p11);
      pushTri(p00, p11, p01);
    } else {
      pushTri(p00, p10, p01);
      pushTri(p10, p11, p01);
    }
  }
}

// ---- Constellation: random stars in a region, each linked to its two nearest neighbours ----
const region =
  constellation === "right"
    ? [W * 0.42, W]
    : constellation === "left"
      ? [0, W * 0.55]
      : [0, W];
const starPts: { x: number; y: number; r: number; tw: boolean }[] = [];
if (constellation !== "none") {
  let guard = 0;
  const minD = Math.min(110, Math.sqrt(((region[1]! - region[0]!) * H) / stars) * 0.7);
  while (starPts.length < stars && guard++ < stars * 40) {
    const x = region[0]! + 20 + rand() * (region[1]! - region[0]! - 40);
    const y = 18 + rand() * (H - 36);
    if (starPts.every((p) => Math.hypot(p.x - x, p.y - y) > minD)) {
      starPts.push({ x: r1(x), y: r1(y), r: r1(2.5 + rand() * 2.8), tw: animate && rand() < 0.25 });
    }
  }
}
const edges = new Set<string>();
const lines: string[] = [];
starPts.forEach((p, i) => {
  const near = starPts
    .map((q, k) => ({ k, d: Math.hypot(q.x - p.x, q.y - p.y) }))
    .filter((o) => o.k !== i)
    .sort((a, b) => a.d - b.d)
    .slice(0, 2);
  for (const n of near) {
    const key = i < n.k ? `${i}-${n.k}` : `${n.k}-${i}`;
    const q = starPts[n.k];
    if (!edges.has(key) && q && n.d < 300) {
      edges.add(key);
      lines.push(`M${p.x} ${p.y}L${q.x} ${q.y}`);
    }
  }
});

// A few four-point sparkles, like the banner's.
const sparkles = Array.from({ length: constellation === "none" ? 0 : 3 }, () => ({
  x: r1(region[0]! + 40 + rand() * (region[1]! - region[0]! - 80)),
  y: r1(30 + rand() * (H - 60)),
  s: r1(7 + rand() * 7),
}));
const sparkle = (x: number, y: number, s: number) =>
  `M${x} ${y - s}Q${x + s * 0.18} ${y - s * 0.18} ${x + s} ${y}Q${x + s * 0.18} ${y + s * 0.18} ${x} ${y + s}Q${x - s * 0.18} ${y + s * 0.18} ${x - s} ${y}Q${x - s * 0.18} ${y - s * 0.18} ${x} ${y - s}Z`;
---

<svg
  class:list={["backdrop", className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g>
    {facets.map((f) => <polygon points={f.points} class={f.fill} opacity={f.opacity} />)}
  </g>
  {lines.length > 0 && <path class="links" d={lines.join("")} />}
  <g class="stars">
    {starPts.map((p) => <circle cx={p.x} cy={p.y} r={p.r} class={p.tw ? "tw" : undefined} />)}
  </g>
  <g class="sparkles">{sparkles.map((s) => <path d={sparkle(s.x, s.y, s.s)} />)}</g>
</svg>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .light {
    fill: #fff;
  }
  .dark {
    fill: #0b4a1e;
  }
  .links {
    fill: none;
    stroke: #fff;
    stroke-width: 1.2;
    opacity: 0.42;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 47.99rem) {
    .links {
      opacity: 0.22;
    }
    .stars,
    .sparkles {
      opacity: 0.6;
    }
  }
  .stars circle {
    fill: #fff;
    opacity: 0.8;
  }
  .sparkles path {
    fill: #fff;
    opacity: 0.7;
  }
  .tw {
    animation: twinkle 3.6s ease-in-out infinite alternate;
  }
  .tw:nth-child(3n) {
    animation-delay: -1.2s;
  }
  .tw:nth-child(3n + 1) {
    animation-delay: -2.4s;
  }
  @keyframes twinkle {
    from {
      opacity: 0.9;
    }
    to {
      opacity: 0.35;
    }
  }
</style>
