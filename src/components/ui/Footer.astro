---
/** Site footer: citation, sources, build info and links. */
import { getBuildInfo } from "~/data";
import { fmtDate } from "~/lib/format";
import { CITATION, CITATION_TEXT, FOOTER_LINKS, SOURCE_LINKS } from "~/lib/site";
import { href } from "~/lib/url";
import LogoIcon from "../brand/LogoIcon.astro";

const info = getBuildInfo();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href={href("/")}>
        <LogoIcon size={44} />
        <span>MitoAge</span>
      </a>
      <p class="site-footer__cite">
        <span class="site-footer__label">Please cite</span>
        {CITATION_TEXT}{" "}
        <a href={`https://doi.org/${CITATION.doi}`}>doi:{CITATION.doi}</a>
      </p>
    </div>
    <nav aria-label="Footer">
      <ul role="list" class="site-footer__links">
        {FOOTER_LINKS.map((l) => <li><a href={href(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-footer__meta">
      <p>
        <span class="site-footer__label">Sources</span>
        {SOURCE_LINKS.map((s, i) => (
          <>
            <a href={s.url}>{s.name}</a>{i < SOURCE_LINKS.length - 1 ? ", " : ""}
          </>
        ))}
      </p>
      <p>
        <span class="site-footer__label">Build</span>
        {info.build} · {info.speciesCount.toLocaleString("en-US")} species · updated {fmtDate(info.generatedAt)}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    line-height: 1.55;
    border-top: 4px solid var(--color-header-accent);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-6) var(--space-8);
    padding-block: var(--space-8);
  }
  .site-footer__brand {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  @media (max-width: 40rem) {
    .site-footer__brand {
      grid-column: auto;
    }
  }
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    align-self: flex-start;
    color: #fff;
    font-size: 1.375rem;
    font-weight: var(--fw-black);
    text-decoration: none;
  }
  .site-footer__label {
    display: block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-footer-muted);
  }
  .site-footer a {
    color: #fff;
  }
  .site-footer a:hover {
    color: var(--lime-300);
  }
  .site-footer__links {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    text-decoration: none;
  }
  .site-footer__links a:hover {
    text-decoration: underline;
  }
  .site-footer__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
