---
/** Compact round MitoAge icon (green disc + mitochondrion). Same art as /favicon.svg. */
import { iconMarkup } from "./mitoSvg";
import { nextId } from "./ids";

interface Props {
  size?: number;
  class?: string;
  /** Accessible name; omit when the icon sits next to the word "MitoAge". */
  label?: string;
}

const { size = 40, class: className, label } = Astro.props;
const markup = iconMarkup(nextId("icon"));
---

<svg
  class:list={["logo-icon", className]}
  viewBox="0 0 64 64"
  width={`${size / 16}rem`}
  height={`${size / 16}rem`}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={markup}
/>

<style>
  .logo-icon {
    flex: none;
    display: block;
  }
</style>
