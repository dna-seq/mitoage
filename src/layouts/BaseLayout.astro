---
/**
 * Page shell with full SEO: title, description, canonical, Open Graph/Twitter, JSON-LD,
 * theme colour and the early theme script.
 *
 * <BaseLayout title="Homo sapiens (Human)" description="..." jsonLd={[taxonLd(...)]}>
 *   ...
 * </BaseLayout>
 *
 * Slots: default (page body inside <main>), "head" (extra tags in <head>).
 */
import "@fontsource-variable/nunito/wght.css";
import "@fontsource-variable/nunito/wght-italic.css";
import nunitoLatin from "@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url";
import "~/styles/global.css";
import Footer from "~/components/ui/Footer.astro";
import Header from "~/components/ui/Header.astro";
import type { JsonLd } from "~/lib/seo";
import { SITE_DESCRIPTION, SITE_NAME } from "~/lib/site";
import { href } from "~/lib/url";
import { absoluteUrl } from "~/lib/urls";

interface Props {
  /** Page title without the site name; omit on the home page. */
  title?: string;
  description?: string;
  /** Canonical path (root-relative or base-prefixed), defaults to the current path. */
  canonicalPath?: string;
  /** Social image, root-relative path on this site. */
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
  jsonLd?: JsonLd | JsonLd[];
  noindex?: boolean;
  /** Pass false on pages that have their own big search (home). */
  headerSearch?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonicalPath,
  image = "/og-image.png",
  imageAlt = "MitoAge: mitochondrial DNA and animal longevity",
  ogType = "website",
  jsonLd,
  noindex = false,
  headerSearch = true,
} = Astro.props;

const site = Astro.site;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}: mitochondrial DNA and animal longevity`;
const canonical = absoluteUrl(canonicalPath ?? Astro.url.pathname, site);
const imageUrl = absoluteUrl(image, site);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ldJson = (o: JsonLd) => JSON.stringify(o).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <script is:inline>
      try {
        var t = localStorage.getItem("mitoage-theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0e4a22" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#082e16" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <link rel="manifest" href={href("/site.webmanifest")} />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />
    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {ld.map((o) => <script type="application/ld+json" set:html={ldJson(o)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header showSearch={headerSearch} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
