---
/**
 * Coevolution of mitochondrial and nuclear proteins (D20): the mitoport tables of mitoage-pipelines,
 * computed on an earlier build, shown for reuse. The page states that none of the measures follows lifespan
 * only after lifespanNull() has checked it on the tables; if the tables ever say otherwise, the build stops.
 */
import { getSpeciesBySlug, PUBLIC_DIR } from "~/data";
import { getMitoport } from "~/data/mitoport";
import Card from "~/components/ui/Card.astro";
import DataTable, { type Column, type Row } from "~/components/ui/DataTable";
import Hero from "~/components/ui/Hero.astro";
import Icon from "~/components/ui/Icon.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { classLabel } from "~/lib/classes";
import { fmtBytes, fmtFixed, fmtInt, fmtPct, fmtSigned, plural } from "~/lib/format";
import { groupLabel } from "~/lib/mitoport";
import { href } from "~/lib/url";
import { speciesUrl } from "~/lib/urls";
import { statSync } from "node:fs";
import { join } from "node:path";
import { mitoportTreeUrl } from "../../../pipeline/sources/mitoport";

const m = getMitoport();
const { manifest: man, verdict } = m;
if (!verdict.holds) {
  throw new Error(`/coevolution/ says that none of these features follows lifespan, and the tables do not show it:\n  ${verdict.failures.join("\n  ")}`);
}

// The page names the licence plainly; mitoport.json keeps the dataset card's own words.
if (!man.license.startsWith("CC BY 4.0")) throw new Error(`/coevolution/ says CC BY 4.0, and mitoport.json says: ${man.license}`);
const pipelinesUrl = mitoportTreeUrl(man.dataset, man.revision, "output/mitoport");
const partnersUrl = mitoportTreeUrl(man.nuclearPartners.dataset, man.nuclearPartners.revision);

// Species joined by slug. Which build the tables were computed on is for the maintainer, not the visitor
// (mitoport.json and its README say it), so a species the join loses is said here, at build time, once.
const onSite = m.species.filter((s) => getSpeciesBySlug(s.slug));
const notOnSite = m.species.filter((s) => !getSpeciesBySlug(s.slug));
const retired = onSite.filter((s) => getSpeciesBySlug(s.slug)!.recordStatus === "retired");
if (notOnSite.length || retired.length) {
  console.warn(
    `/coevolution/: of ${m.species.length} species with a discordance value, ${notOnSite.length} have no page in this build` +
      `${notOnSite.length ? ` (${notOnSite.map((s) => s.slug).join(", ")})` : ""} and ${retired.length} are retired; they are left out of the lists.`,
  );
}

// Lifespan: the test rows ("contact minus control") of both tables, primary model for H12.
type Rec = Record<string, unknown>;
const n = (v: unknown) => (typeof v === "number" ? v : null);
const h9 = m.lifespan.filter((r) => r["variable"] === "contact minus control");
const h12 = m.partners.filter((r) => r["status"] === "tested" && r["feature"] === "contact minus control" && r["model"] === "mass+composition");
const setLabel = (s: string) => (s === "Mammalia" ? "Mammals" : s === "all species" ? "All species" : s === "with nuclear partners" ? "Species with nuclear partners" : s);

const proteinColumns: Column[] = [
  { key: "gene", label: "Protein", primary: true, subKey: "groupLabel" },
  { key: "ercIV", label: "Rate, complex IV", format: "signed3", title: "Rate covariation over branches with COX1-3 (erc.tsv, 62 mammals)" },
  { key: "ercIII", label: "Rate, complex III", format: "signed3", title: "Rate covariation over branches with CYTB (erc.tsv, 62 mammals)" },
  { key: "coembedIV", label: "Embedding, IV", format: "signed3", title: "ESM-2 embedding covariation with COX1-3 (coembed.tsv)" },
  { key: "coembedIII", label: "Embedding, III", format: "signed3", hideOnMobile: true, title: "ESM-2 embedding covariation with CYTB (coembed.tsv)" },
  { key: "coembedI", label: "Embedding, I", format: "signed3", hideOnMobile: true, title: "ESM-2 embedding covariation with ND1-6 and ND4L (coembed.tsv)" },
  { key: "coembedV", label: "Embedding, V", format: "signed3", hideOnMobile: true, title: "ESM-2 embedding covariation with ATP6 and ATP8 (coembed.tsv)" },
  { key: "seqContact", label: "Coupling at contacts", format: "signed3", title: "Sequence coupling of the protein's interface with COX1-3 contact residues (coupling.tsv, seq_contact_iface)" },
  { key: "seqExcessMt", label: "Excess over controls", format: "signed3", title: "Contact coupling minus coupling with burial-matched control residues (coupling.tsv, seq_excess_mt)" },
  { key: "esmExcessMt", label: "Excess, ESM-2", format: "signed3", hideOnMobile: true, title: "The same excess with ESM-2 distances (coupling.tsv, esm_excess_mt)" },
  { key: "couplingSpecies", label: "Mammals", format: "int", hideOnMobile: true, title: "Species the coupling is computed over" },
  { key: "groupLabel", label: "Group", csvOnly: true },
];
const proteinRows: Row[] = m.proteins.map((p) => ({
  gene: p.gene,
  groupLabel: groupLabel(p.group),
  ercIV: p.ercIV,
  ercIII: p.ercIII,
  coembedIV: p.coembedIV,
  coembedIII: p.coembedIII,
  coembedI: p.coembedI,
  coembedV: p.coembedV,
  seqContact: p.seqContact,
  seqExcessMt: p.seqExcessMt,
  esmExcessMt: p.esmExcessMt,
  couplingSpecies: p.couplingSpecies,
}));
const maxMammals = Math.max(...m.proteins.flatMap((p) => [p.coembedSpecies ?? 0, p.couplingSpecies ?? 0]));
const testedFits = m.partners.filter((r) => r["status"] === "tested");
const testedClasses = new Set(testedFits.map((r) => r["class"])).size;
const models = new Set(testedFits.map((r) => r["model"])).size;
const complexIV = m.groups.find((g) => g.group === "complex IV nuclear");
const controls = m.groups.find((g) => g.group === "cytosolic control");

const files = man.files.map((f) => ({ ...f, url: href(`/data/mitoport/${f.file}`), size: statSync(join(PUBLIC_DIR, "mitoport", f.file)).size }));
const notAssessed = verdict.notAssessed.map((x) => `${classLabel(x.class)} (${x.reason})`).join("; ");
const description = `How mitochondrial and nuclear proteins of the respiratory complexes change together across mammals, and each species' discordance at complex IV's mito-nuclear contacts. Tables of mitoage-pipelines, offered for reuse; none of these features follows lifespan.`;
const speciesByClass = m.classes.map((c) => ({
  ...c,
  list: onSite.filter((s) => s.class === c.class).map((s) => getSpeciesBySlug(s.slug)!).sort((a, b) => a.scientificName.localeCompare(b.scientificName)),
}));
---

<BaseLayout title="Mito-nuclear coevolution" description={description}>
  <Hero variant="page" seed={47}>
    <p class="hero__eyebrow">Mito-nuclear coevolution</p>
    <h1 class="hero__title">Mitochondrial and nuclear proteins, evolving together</h1>
    <p class="hero__lede">
      Thirteen proteins of the respiratory chain are encoded in mtDNA; their partners in the same complexes are encoded
      in the nucleus. These tables measure how far the two change together across species. They are offered for reuse:
      none of these measures follows lifespan. Which subunits each complex holds, and which residues of complex IV
      touch, is shown under <a href={href("/complexes/")}>respiratory complexes</a>.
    </p>
  </Hero>

  <div class="container section mp">
    <Card as="section" id="lifespan" title="Lifespan: no signal">
      <p class="card__desc">
        What the analyses asked first, and what they found. The tables below are kept for what else they can tell.
      </p>
      <div class="prose mp-prose">
        <p>
          <strong>Mismatch at complex IV's contacts.</strong> Per species, how often its COX1-3
          residues at the {fmtInt(m.contactResidues)} contacts with nuclear subunits differ from the consensus, minus the same at burial-matched
          non-contact residues, against log10 maximum lifespan with body mass and the dated tree. All {fmtInt(verdict.intervals)} slopes
          have 95% intervals that include zero.
        </p>
        <p>
          <strong>Discordance of the contact pairs.</strong> Per species, the share of
          mito-nuclear contact pairs where exactly one side differs from its class's consensus: one side changed, its partner
          did not. {fmtInt(verdict.testedFits)} fits in {fmtInt(testedClasses)} classes, {fmtInt(models)} models each; the smallest q is
          {" "}{fmtFixed(verdict.smallestQ, 3)}, and none is below 0.05.{notAssessed ? ` Not assessed: ${notAssessed}.` : ""}
        </p>
        <p>
          The same analysis found mitochondrial-side mismatch in reptiles passing narrowly on one alignment and not on
          another with the same 97 species, so it is not read as a finding.
        </p>
      </div>
      <div class="mp-scroll">
        <table class="mp-table">
          <caption class="visually-hidden">Lifespan on contact minus control, per set of species</caption>
          <thead>
            <tr><th scope="col">Measure</th><th scope="col">Species set</th><th scope="col" class="num">Species</th><th scope="col" class="num">Slope</th><th scope="col">95% interval</th><th scope="col" class="num">q</th></tr>
          </thead>
          <tbody>
            {h9.map((r: Rec) => (
              <tr>
                <td>Contact mismatch</td>
                <td>{setLabel(String(r["set"]))}</td>
                <td class="num">{fmtInt(n(r["species"]))}</td>
                <td class="num">{fmtSigned(n(r["slope_log10_years"]), 3)}</td>
                <td>[{fmtSigned(n(r["ci95_low"]), 3)}, {fmtSigned(n(r["ci95_high"]), 3)}]</td>
                <td class="num">–</td>
              </tr>
            ))}
            {h12.map((r: Rec) => (
              <tr>
                <td>Pair discordance</td>
                <td>{classLabel(String(r["class"]))}</td>
                <td class="num">{fmtInt(n(r["n"]))}</td>
                <td class="num">{fmtSigned(n(r["slope_per_sd"]), 3)}</td>
                <td>[{fmtSigned(n(r["ci95_low"]), 3)}, {fmtSigned(n(r["ci95_high"]), 3)}]</td>
                <td class="num">{fmtFixed(n(r["q"]), 2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mp-small muted">
        Slopes are log10 years of maximum lifespan per standard deviation of the measure. Contact mismatch: log10 body mass in the model,
        no multiple-testing correction (one test per set). Pair discordance: body mass and fourfold base composition in the model, q by
        Benjamini-Hochberg within class; the mass-only model and the contact and control terms alone are
        in{" "}<a href={href("/data/mitoport/partners.parquet")}>partners.parquet</a>.
      </p>
    </Card>

    <Card as="section" id="proteins" title="Which nuclear proteins change with the mitochondrial ones">
      <p class="card__desc">
        {fmtInt(m.proteins.length)} nuclear proteins in up to {fmtInt(maxMammals)} mammals: the nuclear subunits of complexes IV and III,
        cytochrome c, complex II (which has no mitochondrial subunit), matrix enzymes that are not respiratory, and
        cytosolic proteins as the control.
      </p>
      <div class="prose mp-prose">
        <p>
          <strong>Rate</strong>: over the branches of the dated tree of 62 mammals, the
          correlation of a protein's rate (relative to the cytosolic controls) with the rate of a complex's mitochondrial
          subunits. <strong>Embedding</strong>: over pairs of mammals, the partial correlation of
          the distance between their ESM-2 protein embeddings with the same for a complex's mitochondrial subunits, time on the
          tree partialled out. <strong>Coupling at contacts</strong>: the same over pairs, by differing residues, between
          the protein's interface and COX1-3's contact residues; the <strong>excess</strong> is that minus the coupling with
          burial-matched residues that touch nothing.
        </p>
        <p>
          Complex IV's nuclear subunits follow the COX genes far more than the cytosolic controls do. Their contact residues,
          though, couple no more than burial-matched residues that touch nothing, beyond what the controls show (p = 0.43):
          the coupling belongs to whole proteins that share a complex with mtDNA products, not to the residues that touch.
          Single correlations are not tested; the analyses compare groups of proteins, as in the medians below.
        </p>
      </div>
      <div class="mp-scroll">
        <table class="mp-table">
          <caption class="visually-hidden">Medians per group of proteins</caption>
          <thead>
            <tr>
              <th scope="col">Group</th><th scope="col" class="num">Proteins</th><th scope="col" class="num">Rate, complex IV</th>
              <th scope="col" class="num">Embedding, IV</th><th scope="col" class="num">Coupling at contacts</th><th scope="col" class="num">Excess over controls</th>
            </tr>
          </thead>
          <tbody>
            {m.groups.map((g) => (
              <tr class:list={[g.group === "complex IV nuclear" && "mp-hl"]}>
                <th scope="row">{groupLabel(g.group)}</th>
                <td class="num">{fmtInt(g.proteins)}</td>
                <td class="num">{fmtSigned(g.medians.ercIV.median, 3)}</td>
                <td class="num">{fmtSigned(g.medians.coembedIV.median, 3)}</td>
                <td class="num">{fmtSigned(g.medians.seqContact.median, 3)}</td>
                <td class="num">{fmtSigned(g.medians.seqExcessMt.median, 3)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mp-small muted">
        Medians over the proteins of each group that have the value.
        {complexIV && controls ? ` Complex IV's nuclear subunits against the cytosolic controls: coupling at contacts ${fmtSigned(complexIV.medians.seqContact.median, 2)} against ${fmtSigned(controls.medians.seqContact.median, 2)}; excess ${fmtSigned(complexIV.medians.seqExcessMt.median, 3)} against ${fmtSigned(controls.medians.seqExcessMt.median, 3)}.` : ""}{" "}
        A dash is a value the analysis did not compute (too few species, or no interface).
      </p>
      <DataTable
        client:visible
        caption="Coevolution of each nuclear protein with the mitochondrial subunits"
        columns={proteinColumns}
        rows={proteinRows}
        noun={["protein", "proteins"]}
        search={{ keys: ["gene", "groupLabel"], placeholder: "Filter proteins" }}
        facets={[{ key: "groupLabel", label: "Group", allLabel: "All groups" }]}
        csv={{ filename: "mitoage-coevolution-proteins.csv" }}
      />
    </Card>

    <Card as="section" id="species" title="Discordance at complex IV's contacts, per species">
      <p class="card__desc">
        {fmtInt(m.species.length)} species with nuclear subunit sequences; each has the value on its own page.
      </p>
      <div class="prose mp-prose">
        <p>
          A pair is a COX1-3 residue and a nuclear residue within 4.5 Å of it in the human enzyme (PDB 5Z62). In a species
          a pair is discordant when exactly one of its two residues differs from its column's consensus among the class's
          species. The control pairs keep the nuclear residue and take a burial-matched mitochondrial residue that touches
          nothing. A species is scored when it fills at least half the contact pairs on both sides.
        </p>
      </div>
      <div class="mp-scroll">
        <table class="mp-table">
          <caption class="visually-hidden">Discordance per class</caption>
          <thead>
            <tr><th scope="col">Class</th><th scope="col" class="num">Species</th><th scope="col" class="num">Scored</th><th scope="col" class="num">Discordant at contacts</th><th scope="col" class="num">Discordant at controls</th></tr>
          </thead>
          <tbody>
            {m.classes.map((c) => (
              <tr>
                <th scope="row">{classLabel(c.class)}</th>
                <td class="num">{fmtInt(c.species)}</td>
                <td class="num">{fmtInt(c.scored)}</td>
                <td class="num">{fmtPct(c.meanContact === null ? null : c.meanContact * 100, 1)}</td>
                <td class="num">{fmtPct(c.meanControl === null ? null : c.meanControl * 100, 1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mp-small muted">Shares of pairs, averaged over the scored species of each class.</p>
      {speciesByClass.map((c) => (
        <details class="mp-species">
          <summary>{classLabel(c.class)}: {plural(c.list.length, "species", "species")}</summary>
          <ul role="list" class="mp-species__list">
            {c.list.map((s) => (
              <li><a href={`${speciesUrl(s.slug)}#coevolution`}><i>{s.scientificName}</i></a></li>
            ))}
          </ul>
        </details>
      ))}
    </Card>

    <Card as="section" id="downloads" title="Downloads">
      <p class="card__desc">
        The tables as parquet, values unchanged from <a href={pipelinesUrl}>the source</a>. Licence: <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
      </p>
      <ul role="list" class="data-files">
        {files.map((f) => (
          <li>
            <a class="row-link" href={f.url} download>
              <span class="data-files__ext">parquet</span>
              <span class="row-link__main">
                {f.file}
                <span class="row-link__sub">{f.description} {fmtInt(f.rows)} rows.</span>
              </span>
              <span class="data-files__size">{fmtBytes(f.size)}</span>
              <Icon name="download" class="row-link__chev" />
            </a>
          </li>
        ))}
        <li>
          <a class="row-link" href={href("/data/mitoport/mitoport.json")} download>
            <span class="data-files__ext">json</span>
            <span class="row-link__main">mitoport.json<span class="row-link__sub">Where each table comes from: revision, source path, SHA-256, columns.</span></span>
            <Icon name="download" class="row-link__chev" />
          </a>
        </li>
      </ul>
      <p class="mp-small">
        The nuclear ortholog sets and their alignments: <a href={partnersUrl}>{man.nuclearPartners.dataset}</a>. The code: <a href="https://github.com/dna-seq/mitoage-pipelines">dna-seq/mitoage-pipelines</a>.
        Nothing here is peer reviewed.
      </p>
    </Card>
  </div>
</BaseLayout>

<style>
  .mp {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .mp-prose {
    max-width: 75ch;
    margin-block: var(--space-4);
  }
  .mp-scroll {
    overflow-x: auto;
    margin-block: var(--space-3);
  }
  .mp-table {
    border-collapse: collapse;
    font-size: var(--fs-sm);
    min-width: 100%;
  }
  .mp-table th,
  .mp-table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    white-space: nowrap;
  }
  .mp-table thead th {
    font-weight: var(--fw-bold);
  }
  .mp-table tbody th {
    font-weight: var(--fw-semibold);
  }
  .mp-table .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .mp-hl {
    background: var(--color-surface-sunken);
  }
  .mp-small {
    font-size: var(--fs-sm);
    max-width: 75ch;
    margin-block: var(--space-3);
  }
  .mp-species {
    margin-block: var(--space-2);
  }
  .mp-species summary {
    cursor: pointer;
    font-weight: var(--fw-bold);
  }
  .mp-species__list {
    columns: 16rem;
    column-gap: var(--space-6);
    font-size: var(--fs-sm);
    padding: var(--space-3) 0 0;
    margin: 0;
  }
  .mp-species__list li {
    break-inside: avoid;
    padding-block: 0.15rem;
  }
</style>
