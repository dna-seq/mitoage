---
import { getAllSpecies, getBuildInfo, PROTEIN_GENES } from "~/data";
import BadgeLogo from "~/components/brand/BadgeLogo.astro";
import Scatter from "~/components/charts/Scatter";
import Button from "~/components/ui/Button.astro";
import Card from "~/components/ui/Card.astro";
import Chip from "~/components/ui/Chip.astro";
import Hero from "~/components/ui/Hero.astro";
import Icon from "~/components/ui/Icon.astro";
import SearchBox from "~/components/ui/SearchBox";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import StatCard from "~/components/ui/StatCard.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { CLASS_GROUPS, classColor, classLabel } from "~/lib/classes";
import { fmtInt, fmtLifespan, fmtLifespanLong } from "~/lib/format";
import { gcLifespanPoints, keySpeciesPresent } from "~/lib/scatter";
import { websiteLd } from "~/lib/seo";
import { SITE_DESCRIPTION } from "~/lib/site";
import { taxaOfRank } from "~/lib/taxa";
import { href } from "~/lib/url";
import { speciesUrl, taxonUrl } from "~/lib/urls";

const species = getAllSpecies();
const info = getBuildInfo();
const classes = taxaOfRank("class").sort((a, b) => b.speciesCount - a.speciesCount);
const orders = taxaOfRank("order");

const byLifespan = [...species].sort((a, b) => b.maxLongevityYears - a.maxLongevityYears);
const longest = byLifespan[0];
const shortest = byLifespan[byLifespan.length - 1];

const points = gcLifespanPoints();
const keyIds = keySpeciesPresent();

// Example chips: well-known species, if present in this build.
const EXAMPLES = ["homo-sapiens", "heterocephalus-glaber", "balaena-mysticetus", "mus-musculus"];
const examples = EXAMPLES.map((slug) => species.find((s) => s.slug === slug)).filter(
  (s): s is NonNullable<typeof s> => s !== undefined,
);

const headline =
  longest && shortest
    ? `Why do some animals live ${fmtLifespanLong(longest.maxLongevityYears)} and others ${fmtLifespanLong(shortest.maxLongevityYears)}?`
    : "Why do some animals live so much longer than others?";
const shownClasses = classes.slice(0, 6);
---

<BaseLayout description={SITE_DESCRIPTION} jsonLd={websiteLd(Astro.site)} headerSearch={false}>
  <Hero variant="home" seed={5} wave>
    <p class="hero__eyebrow">Mitochondrial DNA and animal longevity</p>
    <h1 class="hero__title">{headline}</h1>
    <p class="hero__lede">
      Compare the mitochondrial genomes of {fmtInt(species.length)} species, from base composition to codon usage,
      against their maximum lifespan.
    </p>
    <div class="home-search">
      <SearchBox client:load variant="hero" placeholder="Bowhead whale, Primates, ND6" submitButton />
    </div>
    {
      examples.length > 0 && (
        <div class="cluster" style="--cluster-gap: var(--space-2)">
          <span class="visually-hidden">Try:</span>
          {examples.map((s) => (
            <Chip href={speciesUrl(s.slug)} variant="outline-light">
              {s.commonName || s.scientificName}
            </Chip>
          ))}
        </div>
      )
    }
    <Fragment slot="aside">
      <div class="home-badge"><BadgeLogo /></div>
    </Fragment>
  </Hero>

  <section class="container home-stats" aria-label="The database in numbers">
    <div class="stat-grid">
      <StatCard value={fmtInt(species.length)} label="species with a complete mtDNA" tone="green" />
      <StatCard
        value={fmtInt(classes.length)}
        label={`classes, ${fmtInt(orders.length)} orders`}
        tone="orange"
      />
      <StatCard value={String(PROTEIN_GENES.length)} label="protein-coding genes per genome" tone="sky" />
      {
        longest && (
          <StatCard
            value={fmtLifespan(longest.maxLongevityYears)}
            label={`longest lifespan: ${longest.commonName || longest.scientificName}`}
            tone="red"
          />
        )
      }
    </div>
  </section>

  <section class="container section home-main">
    <div class="home-browse">
      <SectionHeader title="Browse by class" eyebrow="Taxonomy" />
      <ul role="list" class="stack" style="--stack-gap: var(--space-3)">
        {
          shownClasses.map((c) => (
            <li>
              <a class="row-link" href={taxonUrl("class", c.slug)} style={`--dot:${classColor(c.name)}`}>
                <span class="row-link__dot" aria-hidden="true" />
                <span class="row-link__main">
                  {classLabel(c.name)}
                  <span class="row-link__sub">{c.name}</span>
                </span>
                <span class="row-link__value">{fmtInt(c.speciesCount)}</span>
                <Icon name="chevronRight" class="row-link__chev" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href={href("/tree/")} class="home-more">
        All {fmtInt(classes.length)} classes in the taxonomy tree <Icon name="arrowRight" size={18} />
      </a>
    </div>

    <Card class="home-plot" title="GC content against lifespan" as="section" id="gc-lifespan">
      <span slot="actions" class="card__desc">Whole mtDNA, all {fmtInt(points.length)} species</span>
      <Scatter
        client:visible
        points={points}
        groups={CLASS_GROUPS}
        xLog
        xLabel="Maximum lifespan, log scale"
        yLabel="GC %"
        xFormat="lifespan"
        yFormat="percent"
        labelIds={keyIds}
        interactiveLegend
        ariaLabel={`Scatter plot of whole-genome GC percent against maximum lifespan for ${points.length} species, coloured by class`}
        note="Hover or tap a point to see the species; select it again to open its page. Legend buttons spotlight a class."
      />
      <Fragment slot="footer">
        <Button href={href("/explore/")} variant="primary" iconEnd="arrowRight">Open the plot explorer</Button>
      </Fragment>
    </Card>
  </section>

  <section class="home-band" aria-labelledby="features-title">
    <div class="container section">
      <h2 id="features-title" class="visually-hidden">What you can do</h2>
      <div class="grid-auto" style="--grid-min: 16rem; --grid-gap: var(--space-7)">
        <a class="feature" href={href("/compare/")}>
          <svg class="feature__art" viewBox="0 0 96 72" aria-hidden="true">
            <rect x="6" y="14" width="38" height="50" rx="10" fill="#fff" stroke="#17305c" stroke-width="3" />
            <rect x="52" y="8" width="38" height="56" rx="10" fill="#fff" stroke="#17305c" stroke-width="3" />
            <rect x="13" y="40" width="8" height="17" rx="3" fill="#2e9a3c" />
            <rect x="25" y="30" width="8" height="27" rx="3" fill="#f7a81b" />
            <rect x="59" y="26" width="8" height="31" rx="3" fill="#2e9a3c" />
            <rect x="71" y="18" width="8" height="39" rx="3" fill="#e8503a" />
            <path d="M44 38h8" stroke="#17305c" stroke-width="3" stroke-linecap="round" />
          </svg>
          <h3>Compare side by side</h3>
          <p>Put any species or taxa next to each other and share the link.</p>
        </a>
        <a class="feature" href={href("/about/")}>
          <svg class="feature__art" viewBox="0 0 96 72" aria-hidden="true">
            <path d="M10 62h78M10 62V8" stroke="#17305c" stroke-width="3" stroke-linecap="round" fill="none" />
            <path d="M14 54L86 16" stroke="#e8503a" stroke-width="3" stroke-dasharray="5 5" stroke-linecap="round" />
            <g fill="#2e9a3c"><circle cx="22" cy="50" r="5" /><circle cx="34" cy="40" r="5" /><circle cx="44" cy="46" r="5" /><circle cx="56" cy="30" r="5" /><circle cx="68" cy="32" r="5" /><circle cx="78" cy="18" r="5" /></g>
            <g fill="#5bb3e6"><circle cx="28" cy="56" r="4" /><circle cx="50" cy="38" r="4" /><circle cx="72" cy="26" r="4" /></g>
          </svg>
          <h3>Statistics you can trust</h3>
          <p>Correlations per clade, corrected for multiple testing and shared ancestry.</p>
        </a>
        <a class="feature" href={href("/data/")}>
          <svg class="feature__art" viewBox="0 0 96 72" aria-hidden="true">
            <ellipse cx="48" cy="16" rx="30" ry="9" fill="#b9dc35" stroke="#17305c" stroke-width="3" />
            <path d="M18 16v38c0 5 13 9 30 9s30-4 30-9V16" fill="#fff" stroke="#17305c" stroke-width="3" />
            <path d="M18 29c0 5 13 9 30 9s30-4 30-9M18 42c0 5 13 9 30 9s30-4 30-9" fill="none" stroke="#17305c" stroke-width="3" />
            <path d="M48 30v18m-7-7l7 7 7-7" stroke="#e8503a" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
          <h3>Open data</h3>
          <p>Every table as Parquet and CSV, ready for Python, R or DuckDB.</p>
        </a>
      </div>
      <p class="home-build muted">
        {info.build} · data from {info.sources.map((s) => s.name).join(", ")}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-search {
    max-width: 38rem;
  }
  .home-badge {
    width: clamp(15rem, 27vw, 22rem);
    filter: drop-shadow(0 14px 24px rgb(11 74 30 / 0.35));
  }
  @media (max-width: 47.99rem) {
    .home-badge {
      width: min(62vw, 15rem);
    }
  }
  .home-stats {
    position: relative;
    margin-top: calc(-1 * clamp(0.5rem, 2vw, 1.25rem));
  }
  .home-main {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
  }
  .home-browse {
    flex: 1 1 22rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .home-browse :global(.section-head) {
    margin-bottom: 0;
  }
  .home-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    align-self: flex-start;
  }
  :global(.home-plot) {
    flex: 2 1 32rem;
  }
  .home-band {
    background: var(--grad-band);
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    margin: calc(-1 * var(--space-4));
    border-radius: var(--radius-lg);
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .feature:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }
  .feature__art {
    box-sizing: content-box;
    width: 6rem;
    height: 4.5rem;
    padding: 0.5rem 0.625rem;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--lime-50);
    box-shadow: var(--shadow-sm);
  }
  .feature p {
    font-weight: var(--fw-bold);
    line-height: 1.45;
  }
  .home-build {
    margin-top: var(--space-8);
    font-size: var(--fs-sm);
  }
</style>
