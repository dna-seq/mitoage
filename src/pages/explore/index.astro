---
/**
 * /explore/ moved to /compare/plot/. A plain redirect would drop the view in the query string
 * (?x=&y=&scope=...), so a script forwards it; the meta refresh covers readers without JavaScript.
 */
import { href } from "~/lib/url";
import { absoluteUrl } from "~/lib/urls";

const to = href("/compare/plot/");
const canonical = absoluteUrl("/compare/plot/", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to {to}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ to }}>
      location.replace(to + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body>
    <p>The plot explorer has moved to <a href={to}>{to}</a>.</p>
  </body>
</html>
