---
import { getAllSpecies } from "~/data";
import DataTable, { type Column, type Row } from "~/components/ui/DataTable";
import Hero from "~/components/ui/Hero.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { classLabel } from "~/lib/classes";
import { fmtInt } from "~/lib/format";
import { breadcrumbLd } from "~/lib/seo";
import { speciesUrl } from "~/lib/urls";

const species = getAllSpecies();
const rows: Row[] = species.map((s) => ({
  name: s.scientificName,
  common: s.commonName,
  href: speciesUrl(s.slug),
  cls: classLabel(s.taxonomy.class),
  order: s.taxonomy.order,
  family: s.taxonomy.family,
  lifespan: s.maxLongevityYears,
  size: s.mtdnaSizeBp,
  gc: s.gcPercent,
  nonCoding: s.nonCodingBp,
}));
const columns: Column[] = [
  { key: "name", label: "Species", kind: "sci", hrefKey: "href", subKey: "common", primary: true },
  { key: "cls", label: "Class" },
  { key: "order", label: "Order", hideOnMobile: true },
  { key: "lifespan", label: "Max lifespan", format: "lifespan" },
  { key: "size", label: "mtDNA size", format: "bp" },
  { key: "gc", label: "GC", format: "pct2" },
  { key: "nonCoding", label: "Non-coding", format: "bp", hideOnMobile: true },
];
const description = `All ${fmtInt(species.length)} species in MitoAge with maximum lifespan, mitochondrial genome size, GC content and non-coding length. Sort, filter and open any species.`;
---

<BaseLayout
  title="All species"
  description={description}
  jsonLd={breadcrumbLd(Astro.site, [{ name: "Species", path: "/species/" }])}
>
  <Hero variant="strip" seed={11}>
    <p class="hero__eyebrow">Browse</p>
    <h1 class="hero__title">{fmtInt(species.length)} species</h1>
    <p class="hero__lede">Every animal with a complete RefSeq mitochondrial genome and a known maximum lifespan.</p>
  </Hero>
  <section class="container section--tight sp-index">
    <div class="card">
      <DataTable
        client:load
        caption="Species in MitoAge"
        columns={columns}
        rows={rows}
        initialSort={{ key: "lifespan", dir: "desc" }}
        pageSize={50}
        search={{ keys: ["name", "common", "order", "family", "cls"], placeholder: "Filter by name, order or family" }}
        facets={[{ key: "cls", label: "Class", allLabel: "All classes" }]}
        urlParam="q"
        noun={["species", "species"]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .sp-index {
    padding-bottom: var(--section-gap);
  }
</style>
