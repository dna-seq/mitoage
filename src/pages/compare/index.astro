---
/**
 * /compare/ - comparative mtDNA statistics of all species (see GroupPage). Old links to the
 * species comparison, /compare/?species=a,b, are forwarded to /compare/species/?species=a,b.
 */
import GroupPage from "~/components/compare/stats/GroupPage.astro";
import { getStatsGroup } from "~/lib/compare/build";
import { href } from "~/lib/url";

const group = getStatsGroup("all")!;
const speciesPage = href("/compare/species/");
---

<GroupPage group={group}>
  <script is:inline slot="head" define:vars={{ speciesPage }}>
    if (/[?&]species=/.test(location.search)) location.replace(speciesPage + location.search + location.hash);
  </script>
</GroupPage>
