{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "pipeline/**/*",
    "astro.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "types": [
      "bun"
    ]
  }
}
